<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <LangVersion>12.0</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup Condition="'$(DataLinqCandidateVersion)' == ''">
    <ProjectReference Include="../../../src/DataLinq/DataLinq.csproj" />
    <ProjectReference Include="../../../src/DataLinq.SQLite/DataLinq.SQLite.csproj" />
    <ProjectReference Include="../../../src/DataLinq.MySql/DataLinq.MySql.csproj" />
    <ProjectReference Include="../../../src/DataLinq.Generators/DataLinq.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup Condition="'$(DataLinqCandidateVersion)' != ''">
    <PackageReference Include="DataLinq" Version="[$(DataLinqCandidateVersion)]" />
    <PackageReference Include="DataLinq.SQLite" Version="[$(DataLinqCandidateVersion)]" />
    <PackageReference Include="DataLinq.MySql" Version="[$(DataLinqCandidateVersion)]" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
    <Compile Include="../W4SessionConsumer/BindingModels.cs" Link="Models.cs" />
    <Compile Include="../PublicAsyncQueryConsumer/LegacyProvider.cs" Link="LegacyProvider.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
</Project>
