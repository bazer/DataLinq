<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <LangVersion>14.0</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="DataLinq" Version="[0.9.2]" />
    <PackageReference Include="DataLinq.SQLite" Version="[0.9.2]" />
    <Compile Include="../PublicAsyncQueryConsumer/Legacy*.cs" Link="%(Filename)%(Extension)" />
    <Compile Include="../../../test-infra/package-consumer/PackageConsumerModel.cs" Link="PackageConsumerModel.cs" />
  </ItemGroup>
</Project>
