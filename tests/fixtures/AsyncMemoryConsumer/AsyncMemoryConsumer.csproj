<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <LangVersion>14.0</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="DataLinq" Version="[$(DataLinqCandidateVersion)]" />
    <PackageReference Include="DataLinq.Memory" Version="[$(DataLinqCandidateVersion)]" />
    <Compile Include="../../../test-infra/package-consumer/PackageConsumerModel.cs" Link="PackageConsumerModel.cs" />
  </ItemGroup>
  <Target Name="RequireCandidate" BeforeTargets="CollectPackageReferences;PrepareForBuild">
    <Error Condition="'$(DataLinqCandidateVersion)' == ''" Text="Supply the exact DataLinqCandidateVersion." />
  </Target>
</Project>
